{
  "name": "hadith-api",
  "version": "1.0.0",
  "description": "hadith api based on dorar.net",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage",
    "test:integration": "npm test -- tests/integration",
    "check:browser": "node scripts/check-dorar-browser.js"
  },
  "keywords": [
    "hadith",
    "api",
    "sunnah"
  ],
  "author": "أحمد الطبراني (Ahmed El-Tabarani)",
  "license": "MIT",
  "dependencies": {
    "@sparticuz/chromium": "153.0.0",
    "connect-timeout": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.17.3",
    "express-rate-limit": "^6.9.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "html-entities": "^2.3.3",
    "linkedom": "0.18.12",
    "node-cache": "^5.1.2",
    "puppeteer-core": "25.12.0",
    "swagger-ui-express": "^5.0.1",
    "undici": "^7.30.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "nodemon": "^2.0.15",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=24.16.0",
    "npm": ">=11.16.0"
  }
}
