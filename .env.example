PORT=5000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_EACH=86400000 # 24h in ms

# Caching
CACHE_EACH=300 # seconds
CACHE_STABLE_EACH=86400 # hadith details, explanations, and similar results
DORAR_BROWSER_STRATEGY=reuse # reuse or isolated

# Fetch Timeout
FETCH_TIMEOUT=15000 # 15s in ms
BROWSER_FETCH_TIMEOUT=40000 # includes Chromium cold startup and navigation

# auto: try HTTP, then Chromium on HTTP 403. browser: always use Chromium.
# http: disable Chromium and use HTTP only.
DORAR_FETCH_MODE=auto

# Optional local Chrome/Chromium executable. Leave empty on a compatible
# Linux x64 host to use the bundled serverless Chromium binary. On macOS
# and Windows, set the path to an installed Chrome or Chromium.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# Optional outbound HTTP CONNECT proxy with access permitted by Dorar.
# Supports http:// or https:// URLs and URL-encoded username/password.
# Leave empty to connect directly. Restart the server after changing it.
DORAR_PROXY_URL=

# Pagination
# Dorar API return 15 hadiths per page, if the website changes this value, update accordingly
HADITH_API_PAGE_SIZE=15
# Dorar Site returns 30 hadiths per page, if the website changes this value, update accordingly
HADITH_SITE_PAGE_SIZE=30

# Express Settings
EXPRESS_TIMEOUT=60s # covers HTTP fallback and Chromium cold starts
EXPRESS_JSON_LIMIT=10kb
